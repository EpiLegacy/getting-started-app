# Reinstalled inside the image, never copied from the host: native binaries are
# built for the developer's OS, and the build context stays needlessly heavy.
node_modules

# Build artifacts: regenerated by the "build" stage.
build
dist
coverage

# Outside the runtime scope.
.git
.github
.idea
.vscode
spec
*.md

# Must never end up in a published image.
.env
.env.*
*.db
*.sqlite
*.sqlite3

Dockerfile
.dockerignore
docker-compose*.yml
