# Copy to ".env" and adjust. This file is committed, .env is not.
# The values below are for local development only and must never be reused for
# an exposed environment.

# Ports published on the host machine (change them on local conflicts).
API_PORT=3000
MYSQL_PORT=3306
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Database
MYSQL_DB=todos
MYSQL_USER=todo
MYSQL_PASSWORD=todo_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Event broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Auth — session cookie encryption key.
# MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit a real secret here; this is a dev placeholder only.
SESSION_SECRET=change_me_to_a_random_64_char_hex_string_before_running
