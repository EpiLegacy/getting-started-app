      "id": 9,
      "title": "Requests per second",
      "description": "Completed auth/task requests. Health probes, scrapes and static assets are excluded.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kanban-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
