# Copy to ".env" on the server, next to compose.yml, and replace every value.
# This file is committed; the real .env never is. Generate each password with
# something like: openssl rand -base64 24

# The public address. A domain name gets a certificate automatically; the DNS
# record must already point at the server and ports 80 and 443 must be open.
SITE_ADDRESS=kanban.example.org

# Database
MYSQL_DB=todos
MYSQL_USER=todo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Event broker
RABBITMQ_USER=kanban
RABBITMQ_PASSWORD=change-me-as-well

# Rehearsals only: serve plain HTTP on a local port, without a certificate.
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# SESSION_COOKIE_SECURE=false
